{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "paths": {
      "@novatv/sdk": ["../sdk/src/index.ts"],
      "@novatv/sdk/testing": ["../sdk/src/testing.ts"]
    }
  },
  "include": ["*/src", "*/test"]
}
