{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NOVA TV main window. Only file pickers and fullscreen toggling are exposed directly; every launch/open goes through validated NOVA commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "dialog:allow-open",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "nova-ui"
  ]
}
