{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA TV",
  "version": "0.3.1",
  "identifier": "com.ivnov.novatv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "NOVA TV",
        "url": "splash.html",
        "width": 560,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "focus": true,
        "backgroundColor": "#05070f",
        "useHttpsScheme": true
      },
      {
        "label": "volume",
        "create": false,
        "title": "Volumen",
        "url": "volume.html",
        "width": 132,
        "height": 440,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "useHttpsScheme": true
      },
      {
        "label": "main",
        "create": false,
        "title": "NOVA TV",
        "width": 1600,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "maximized": true,
        "center": true,
        "backgroundColor": "#05070f",
        "useHttpsScheme": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src https://www.youtube.com https://player.twitch.tv; img-src 'self' data: https:; media-src https: blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https:",
      "devCsp": "default-src 'self'; frame-src https://www.youtube.com https://player.twitch.tv; img-src 'self' data: https:; media-src https: blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4MTEzQTE2MDVGRkZDOEQKUldTTi9QOEZGam9ST0hBZFAzNlZZVFpBWTJ2MytnWklJb0FHbm1HcitlK1d4TXBtd0orRGo3MkUK",
      "endpoints": ["https://github.com/ivnovomi/nova-tv-releases/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
